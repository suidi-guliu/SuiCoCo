{
  "id": "suicj.lang.c-cpp",
  "name": "C/C++ 语言支持",
  "version": "0.1.0",
  "publisher": "suicoco-official",
  "description": "C 与 C++ 语法高亮、代码补全、代码片段与编译运行任务（依赖 cpp 语言环境，官方源安装）。",
  "engines": { "suicoco": ">=0.1.0" },
  "main": "main.js",
  "requiresEnv": "cpp",
  "categories": ["语言环境", "编程语言"],
  "activationEvents": ["onLanguage:c", "onLanguage:cpp"],
  "contributes": {
    "languages": [
      { "id": "c", "extensions": [".c", ".h"] },
      { "id": "cpp", "extensions": [".cpp", ".cc", ".cxx", ".hpp", ".ipp"] }
    ]
  }
}
